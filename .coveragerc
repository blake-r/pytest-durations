[run]
branch = true
source = pytest_durations
disable_warnings = module-not-measured

[report]
exclude_lines =
    def __repr__
    if self\.debug
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    from typing import Self
omit =
    */types.py
show_missing = true
skip_covered = true
skip_empty = true
fail_under = 100
